{
    "layer": "top",
    "position": "top",
    "height": 32,
    "reload_style_on_change": true,

    // 三段式佈局
    "modules-left": ["custom/power", "cpu", "memory", "temperature", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "battery", "bluetooth", "network"],

    // --- 模組詳細設定 ---

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

	"custom/power": {
        "format": "󰣇",
			"tooltip": false,
			"menu": "on-click",
			"menu-file": "~/.config/waybar/power_menu.xml",
        	"menu-actions": {
            	"shutdown": "shutdown",
            	"reboot": "reboot",
            	"suspend": "systemctl suspend",
            	"hibernate": "systemctl hibernate"
        	}
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠 {usage:>2}%"
    },

    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage:>2}%"
    },

	"temperature": {
		"interval": 2,
		"hwmon-path": "/sys/class/hwmon/hwmon8/temp1_input",
		"critical-threshold": 80,
		"format-critical": "󰔄 {temperatureC}",
		"format": "󰔄 {temperatureC}"
	},

    "clock": {
        "interval": 1,
		"tooltip": false,
        "format": "{:%m-%d %H:%M:%S}"
    },

	"tray": {
		"icon-size": 16,
		"spacing": 8
	},

	"battery": {
		"format": "{icon} {capacity}%",
		"format-icons": {
			"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
		}
	},

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip": true,
		"tooltip-format": "{controller_alias}",
		"tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}"
    },

	"network": {
        "interval": 10,
		"format": "󰲛",
		"format-wifi": "{icon}",
		"format-icons":["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"format-ethernet": "󰈀",
		"format-linked": "󰲝",
		"format-disconnected": "󰲜",
		"tooltip-format": "OFF",
		"tooltip-format-wifi": "{essid} ({signalStrength}%)",
		"tooltip-format-ethernet": "{ifname} 󰈀",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 50
	}
}
