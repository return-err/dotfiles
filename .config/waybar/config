{
    "layer": "top",
    "position": "top",
    "height": 26,
    "reload_style_on_change": true,

    // 三段式佈局
    "modules-left": ["custom/power", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "cpu", "memory", "battery", "bluetooth", "network"],

    // --- 模組詳細設定 ---

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

	"custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "on-click": "systemctl poweroff",      // 左鍵直接關機
        "on-click-right": "systemctl reboot"   // 右鍵重啟
    },

    // "hyprland/window": {
        // "format": "> {}",
        // "separate-outputs": true,
		// "rewrite": {
			// 使用正則匹配：當長度超過 30 個字時，只保留最後 30 個字元，並在前面加上 "..."
        	// "(.*)(.{30})$": "...$2"
    	// }
    // },

    "clock": {
        "interval": 1,
        "format": "{:%m-%d %H:%M:%S}"
    },

	"tray": {
		"icon-size": 16,
		"spacing": 8
	},

    "cpu": {
        "interval": 2,
        "format": "CPU:{usage:>2}%"
    },

    "memory": {
        "interval": 2,
        "format": "RAM:{percentage:>2}%"
    },

    "battery": {
        "format": "󰁹 {capacity}%"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂯{num_connections}",
        "tooltip": true,
		"tooltip-format": "{controller_alias}",
		"tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "• {device_alias}"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
		"tooltip-format": "{ifname} via {gwaddr} 󰈀",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected"
    }
}
